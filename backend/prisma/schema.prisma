generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}
enum OrderStatus {
  PENDING
  PROCESSING
  IN_PROGRESS
  COMPLETED
  PARTIAL
  CANCELLED
  FAILED
  REFUNDED
}
enum PaymentStatus {
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}
enum TransactionType {
  DEPOSIT
  ORDER_PAYMENT
  REFUND
  BONUS
  ADMIN_ADJUSTMENT
}

model User {
  id String @id @default(cuid())
  username String @unique
  email String @unique
  passwordHash String
  role Role @default(USER)
  emailVerified Boolean @default(false)
  disabled Boolean @default(false)
  balance Decimal @default(0) @db.Decimal(18, 6)
  totalSpent Decimal @default(0) @db.Decimal(18, 6)
  referralCode String @unique
  referredById String?
  createdAt DateTime @default(now())
  lastLoginAt DateTime?
  referredBy User? @relation("referrals", fields: [referredById], references: [id])
  referrals User[] @relation("referrals")
  orders Order[]
  transactions WalletTransaction[]
  payments Payment[]
  apiKeys ApiKey[]
  verification EmailVerification?
  passwordReset PasswordResetToken[]
  auditLogs AuditLog[]
}
model Category {
  id String @id @default(cuid())
  name String @unique
  services Service[]
  createdAt DateTime @default(now())
}
model Service {
  id String @id @default(cuid())
  serviceId Int @unique
  name String
  categoryId String
  category Category @relation(fields: [categoryId], references: [id])
  rate Decimal @db.Decimal(18, 6)
  minQuantity Int
  maxQuantity Int
  averageTime String
  providerName String @default("DEMO")
  providerServiceId String?
  description String @default("")
  active Boolean @default(true)
  orders Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([categoryId, active])
}
model Order {
  id String @id @default(cuid())
  orderNumber Int @unique @default(autoincrement())
  userId String
  user User @relation(fields: [userId], references: [id])
  serviceId String
  service Service @relation(fields: [serviceId], references: [id])
  link String
  quantity Int
  charge Decimal @db.Decimal(18, 6)
  providerName String
  providerOrderId String?
  status OrderStatus @default(PENDING)
  startCount Int?
  remains Int?
  adminNote String?
  failureReason String?
  completedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId, createdAt])
  @@index([status, createdAt])
}
model WalletTransaction {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id])
  type TransactionType
  amount Decimal @db.Decimal(18, 6)
  balanceAfter Decimal @db.Decimal(18, 6)
  referenceId String?
  description String
  createdAt DateTime @default(now())
  @@index([userId, createdAt])
}
model Payment {
  id String @id @default(cuid())
  paymentNumber Int @unique @default(autoincrement())
  userId String
  user User @relation(fields: [userId], references: [id])
  amount Decimal @db.Decimal(18, 6)
  utr String @unique
  method String @default("UPI")
  status PaymentStatus @default(PENDING)
  reviewedAt DateTime?
  reviewedById String?
  createdAt DateTime @default(now())
  @@index([status, createdAt])
}
model Provider {
  id String @id @default(cuid())
  name String @unique
  apiUrl String?
  apiKeyEncrypted String?
  markup Decimal @default(0) @db.Decimal(8, 4)
  active Boolean @default(false)
  createdAt DateTime @default(now())
}
model SiteSetting {
  id String @id @default(cuid())
  key String @unique
  value String
  updatedAt DateTime @updatedAt
}
model FAQ {
  id String @id @default(cuid())
  question String
  answer String
  active Boolean @default(true)
  sortOrder Int @default(0)
}
model Announcement {
  id String @id @default(cuid())
  title String
  body String
  active Boolean @default(true)
  createdAt DateTime @default(now())
}
model ApiKey {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id])
  keyHash String @unique
  prefix String
  lastUsedAt DateTime?
  createdAt DateTime @default(now())
}
model EmailVerification {
  id String @id @default(cuid())
  userId String @unique
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerId String?
  codeHash String
  expiresAt DateTime
  attempts Int @default(0)
  createdAt DateTime @default(now())
}
model PasswordResetToken {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String @unique
  expiresAt DateTime
  usedAt DateTime?
  createdAt DateTime @default(now())
}
model AuditLog {
  id String @id @default(cuid())
  adminId String?
  admin User? @relation(fields: [adminId], references: [id])
  action String
  target String?
  description String
  ip String?
  createdAt DateTime @default(now())
  @@index([createdAt])
}
